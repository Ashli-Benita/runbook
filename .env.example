# AI Runbook-Following Agent Configuration Example

# Spring Datasource (PostgreSQL or H2 default)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/runbookdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Server Port
PORT=8080
